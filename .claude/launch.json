{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "konabiz-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5500", "--bind", "127.0.0.1"],
      "port": 5500
    },
    {
      "name": "konabiz-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--reload", "--reload-dir", "backend", "--port", "8000"],
      "port": 8000
    }
  ]
}
